<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SigilBuild.Installer.Host.ViewModels"
             x:DataType="vm:InstallerViewModel"
             x:Class="SigilBuild.Installer.Host.Views.Screens.DowngradeBlockedView">
  <!-- P3 (gap G3): a newer version is already installed and setup will not downgrade.
       A terminal notice screen — no log, no Next; the footer Cancel closes the window
       preserving the dedicated downgrade-blocked exit code (3). -->
  <StackPanel Spacing="14" VerticalAlignment="Center">
    <TextBlock FontSize="20" FontWeight="SemiBold"
               Foreground="{DynamicResource TextPriBrush}"
               Text="A newer version is already installed" />
    <TextBlock Text="{Binding DowngradeBlockedMessage}"
               Foreground="{DynamicResource TextMutBrush}"
               TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
