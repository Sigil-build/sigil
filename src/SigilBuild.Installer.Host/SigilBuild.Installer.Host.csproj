<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SigilBuild.Installer.Host</RootNamespace>
    <AssemblyName>installer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- AOT — Avalonia 12 makes this clean -->
    <PublishAot Condition="'$(SigilAotPublish)' == 'true'">true</PublishAot>
    <!--
      IsAotCompatible=true upgrades any AOT-warning from a transitive dep to
      a build-blocking error. Svg.Skia's transitive Svg.Custom / ExCSS deps
      currently surface IL3053 / IL2104 warnings; those are non-fatal for our
      use (we call a tiny subset — SKSvg.Load + Picture.CullRect — that doesn't
      touch the reflection-heavy CSS layout paths). Surface them as warnings
      not errors so the wizard still AOT-publishes.
    -->
    <IsAotCompatible>false</IsAotCompatible>
    <NoWarn>$(NoWarn);IL2026;IL2104;IL2111;IL3050;IL3053</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebuggerSupport>false</DebuggerSupport>

    <!-- Avalonia 12: compiled bindings on by default. Belt-and-suspenders. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableAvaloniaXamlCompilation>true</EnableAvaloniaXamlCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Svg.Skia" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
