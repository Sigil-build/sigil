<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SigilBuild.Installer.Host.ViewModels"
        x:Class="SigilBuild.Installer.Host.Views.InstallerWindow"
        x:DataType="vm:InstallerViewModel"
        Title="{Binding Brand.AppName}"
        Width="800" Height="500"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource WinBgBrush}">

  <Grid ColumnDefinitions="240,*" RowDefinitions="*,56">

    <!-- Sidebar (rail) with derived brand palette + logo -->
    <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource RailBgBrush}">
      <StackPanel Margin="24" Spacing="16">
        <Image Source="avares://installer/Assets/default-logo.png" Height="48" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Brand.AppName}" Foreground="{DynamicResource RailTextBrush}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Brand.Publisher}" Foreground="{DynamicResource RailMutedBrush}" FontSize="13" />
      </StackPanel>
    </Border>

    <!-- Content host -->
    <ContentControl Grid.Row="0" Grid.Column="1" Margin="32"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource ScreenSelector}" />

    <!-- Footer -->
    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="0,1,0,0" Padding="16,8">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Content="Back" IsEnabled="{Binding CanGoBack}" Click="OnBack" />
        <Button Content="Next" IsEnabled="{Binding CanGoNext}" Click="OnNext" Background="{DynamicResource AccentBrush}" Foreground="White" />
        <Button Content="Cancel" Click="OnCancel" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
