<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SigilBuild.Installer.Host.ViewModels"
             xmlns:loc="clr-namespace:SigilBuild.Wrapper.Core.Localization;assembly=SigilBuild.Wrapper.Core"
             x:DataType="vm:InstallerViewModel"
             x:Class="SigilBuild.Installer.Host.Views.Screens.LicenseView">
  <Grid RowDefinitions="Auto,*,Auto">
    <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold" Text="{x:Static loc:S.LicenseTitle}" />
    <ScrollViewer Grid.Row="1" Margin="0,8" Background="#F9FAFB" Padding="12">
      <TextBlock Text="{Binding LicenseText}" TextWrapping="Wrap" />
    </ScrollViewer>
    <CheckBox Grid.Row="2" Content="{x:Static loc:S.LicenseAccept}" IsChecked="{Binding LicenseAccepted, Mode=TwoWay}" />
  </Grid>
</UserControl>
