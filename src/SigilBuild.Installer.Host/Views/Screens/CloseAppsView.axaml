<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SigilBuild.Installer.Host.ViewModels"
             xmlns:loc="clr-namespace:SigilBuild.Wrapper.Core.Localization;assembly=SigilBuild.Wrapper.Core"
             x:DataType="vm:ICloseAppsGate"
             x:Class="SigilBuild.Installer.Host.Views.Screens.CloseAppsView">
  <StackPanel Spacing="14" VerticalAlignment="Center">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Static loc:S.CloseAppsTitle}" />
    <TextBlock Foreground="#4B5563" TextWrapping="Wrap"
               Text="{x:Static loc:S.CloseAppsBody}" />

    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
            Height="150" Padding="12,8">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Blockers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Foreground="#374151" FontSize="12" Margin="0,3" TextWrapping="NoWrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Shown when Close for me returned and applications are still running:
         the list above is the fresh scan, and this says the attempt did not
         work rather than leaving the same list to look as if nothing happened. -->
    <TextBlock Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap"
               IsVisible="{Binding CloseAppsFailed}"
               Text="{x:Static loc:S.CloseAppsCloseFailed}" />

    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button Content="{x:Static loc:S.NavRetry}" Click="OnRetry" IsEnabled="{Binding CanActOnBlockers}" />
      <Button Content="{x:Static loc:S.CloseAppsCloseForMe}" Click="OnCloseForMe"
              IsEnabled="{Binding CanActOnBlockers}"
              Background="{DynamicResource AccentBrush}" Foreground="White" />
      <TextBlock VerticalAlignment="Center" Foreground="#4B5563" IsVisible="{Binding IsClosingApps}"
                 Text="{x:Static loc:S.CloseAppsClosing}" />
    </StackPanel>
    <TextBlock Foreground="#6B7280" FontSize="11" TextWrapping="Wrap"
               Text="{x:Static loc:S.CloseAppsCloseForMeHint}" />
  </StackPanel>
</UserControl>
