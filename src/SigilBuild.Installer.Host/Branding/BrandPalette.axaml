<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Literal fallbacks for the derived brand palette (T7). At runtime, a stamped
    exe overrides these via BrandPalette.Apply from the blob's token map; these
    defaults (derived from the neutral primary #1F2937 / accent #3B82F6) keep an
    un-branded dev/preview run rendering. Keys mirror the prototype colors().
  -->
  <Color x:Key="PrimaryColor">#1F2937</Color>
  <Color x:Key="AccentColor">#3B82F6</Color>

  <Color x:Key="RailBgColor">#1F2937</Color>
  <Color x:Key="RailTextColor">#FFFFFF</Color>
  <Color x:Key="RailMutedColor">#BCD5FC</Color>
  <Color x:Key="LogoTileColor">#2B4E87</Color>
  <Color x:Key="AccentHoverColor">#3472D8</Color>
  <Color x:Key="FrameColor">#D0D3D9</Color>
  <Color x:Key="WinBgColor">#FFFFFF</Color>
  <Color x:Key="PaneBgColor">#FFFFFF</Color>
  <Color x:Key="TitleBgColor">#F9FAFB</Color>
  <Color x:Key="BorderColor">#E5E7EB</Color>
  <Color x:Key="TextPriColor">#111827</Color>
  <Color x:Key="TextSecColor">#4B5563</Color>
  <Color x:Key="TextMutColor">#6B7280</Color>
  <Color x:Key="SuccessTextColor">#0F6E56</Color>
  <Color x:Key="SuccessBgColor">#E1F5EE</Color>
  <Color x:Key="InputBgColor">#F9FAFB</Color>
  <Color x:Key="TrackColor">#E5E7EB</Color>
  <Color x:Key="LogBgColor">#F9FAFB</Color>
  <Color x:Key="LogTextColor">#374151</Color>
  <Color x:Key="DangerTextColor">#B42318</Color>
  <Color x:Key="DangerBgColor">#FEE4E2</Color>
  <Color x:Key="GhostHoverColor">#F3F4F6</Color>

  <SolidColorBrush x:Key="PrimaryBrush" Color="{DynamicResource PrimaryColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="RailBgBrush" Color="{DynamicResource RailBgColor}" />
  <SolidColorBrush x:Key="RailTextBrush" Color="{DynamicResource RailTextColor}" />
  <SolidColorBrush x:Key="RailMutedBrush" Color="{DynamicResource RailMutedColor}" />
  <SolidColorBrush x:Key="LogoTileBrush" Color="{DynamicResource LogoTileColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
  <SolidColorBrush x:Key="FrameBrush" Color="{DynamicResource FrameColor}" />
  <SolidColorBrush x:Key="WinBgBrush" Color="{DynamicResource WinBgColor}" />
  <SolidColorBrush x:Key="PaneBgBrush" Color="{DynamicResource PaneBgColor}" />
  <SolidColorBrush x:Key="TitleBgBrush" Color="{DynamicResource TitleBgColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="TextPriBrush" Color="{DynamicResource TextPriColor}" />
  <SolidColorBrush x:Key="TextSecBrush" Color="{DynamicResource TextSecColor}" />
  <SolidColorBrush x:Key="TextMutBrush" Color="{DynamicResource TextMutColor}" />
  <SolidColorBrush x:Key="SuccessTextBrush" Color="{DynamicResource SuccessTextColor}" />
  <SolidColorBrush x:Key="SuccessBgBrush" Color="{DynamicResource SuccessBgColor}" />
  <SolidColorBrush x:Key="InputBgBrush" Color="{DynamicResource InputBgColor}" />
  <SolidColorBrush x:Key="TrackBrush" Color="{DynamicResource TrackColor}" />
  <SolidColorBrush x:Key="LogBgBrush" Color="{DynamicResource LogBgColor}" />
  <SolidColorBrush x:Key="LogTextBrush" Color="{DynamicResource LogTextColor}" />
  <SolidColorBrush x:Key="DangerTextBrush" Color="{DynamicResource DangerTextColor}" />
  <SolidColorBrush x:Key="DangerBgBrush" Color="{DynamicResource DangerBgColor}" />
  <SolidColorBrush x:Key="GhostHoverBrush" Color="{DynamicResource GhostHoverColor}" />
</ResourceDictionary>
