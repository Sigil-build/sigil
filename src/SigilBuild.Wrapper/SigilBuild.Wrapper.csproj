<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      WinExe (not Exe) suppresses the console window that flashes / persists
      when the user double-clicks setup.exe. The wrapper still writes a
      complete trace to the WrapperLog file next to setup.exe; console output
      from `setup.exe /S` etc. is captured by the parent shell if launched
      from cmd / pwsh (Windows auto-attaches stdio to the parent console for
      a WinExe whose parent is a console).
    -->
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SigilBuild.Wrapper</RootNamespace>
    <AssemblyName>SigilBuild.Wrapper</AssemblyName>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PublishAot>true</PublishAot>
    <!-- InvariantGlobalization=true is required for AOT size targets (skips ICU
         loading) and is correct for path/registry comparisons (avoids the
         Turkish-I problem). Wrapper code that needs a UI culture (e.g. localized
         install-wizard error text) MUST use ordinal/invariant comparisons; constructing
         `new CultureInfo("ru-RU")` will throw `CultureNotFoundException` at runtime.
         Localization HAS landed (P9, en + uk) via exactly the mechanism ADR-008 §4
         (docs/architecture/adr-008-expression-policy.md) anticipated: a
         source-generated, culture-neutral string table for built-in wizard chrome,
         NOT .resx satellite assemblies — InvariantGlobalization stays on, unchanged. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>full</TrimMode>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <!-- RuntimeIdentifier and SelfContained are intentionally NOT pinned at the
         project level. Pinning them forces every `dotnet build` (including the
         macOS / Linux CI test jobs that just want the .dll for ProjectReference
         resolution) into a RID-specific bin/<RID>/ subfolder, which dependent
         test projects can't find on non-Windows hosts.

         AOT publishing passes them at the CLI:
             dotnet publish src/SigilBuild.Wrapper -c Release -r win-x64 -p:PublishAot=true
         (PublishAot=true implicitly sets SelfContained=true; -r supplies the
         RID. See .github/workflows/wrapper-vm-tests.yml.) -->
  </PropertyGroup>
  <ItemGroup>
    <!-- The step engine, WrapperBlob, CLI parser and all runtime types now live
         in SigilBuild.Wrapper.Core (extracted in Task T1) so the Avalonia host
         can share them. This project is a thin console/silent shell around it;
         Program.cs is the only remaining source file. Core flows transitively. -->
    <ProjectReference Include="..\SigilBuild.Wrapper.Core\SigilBuild.Wrapper.Core.csproj" />
  </ItemGroup>
</Project>
