<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SigilBuild.Installer.Host.ViewModels"
             x:DataType="vm:InstallerViewModel"
             x:Class="SigilBuild.Installer.Host.Views.Screens.InstallOptionsView">
  <StackPanel Spacing="12">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Install options" />
    <TextBlock Text="Confirm the values below; tab through to edit." Foreground="#4B5563" />

    <ItemsControl ItemsSource="{Binding ParameterFields}" Margin="0,8,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:ParameterFieldVm">
          <StackPanel Spacing="4" Margin="0,0,0,8">
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding Values}"
                      SelectedItem="{Binding CurrentValue, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      IsVisible="{Binding IsEnum}" />
            <TextBox Text="{Binding CurrentValue, Mode=TwoWay}"
                     IsVisible="{Binding IsTextual}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
