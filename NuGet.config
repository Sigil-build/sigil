<?xml version="1.0" encoding="utf-8"?>
<!--
  R23a: declare the feed set explicitly instead of inheriting whatever feeds
  happen to be configured on the machine or CI runner. nuget.org is the only
  source Sigil restores from; <clear /> drops anything a developer's global
  NuGet.Config might otherwise add (a private feed, a local package source,
  etc.) so a restore here is reproducible regardless of the machine it runs
  on. Paired with RestorePackagesWithLockFile (Directory.Build.props) and
  locked-mode restore in CI (ci.yml), this is what makes "the build is not
  reproducible" (R23a) no longer true.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
