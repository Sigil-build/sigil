<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SigilBuild.Installer.Host.ViewModels"
        x:Class="SigilBuild.Installer.Host.Views.InstallerWindow"
        x:DataType="vm:InstallerViewModel"
        Title="{Binding Brand.AppName}"
        Width="800" Height="500"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource WinBgBrush}">

  <Grid ColumnDefinitions="240,*" RowDefinitions="*,56">

    <!-- Sidebar (rail): brand block (T7) on top, step indicator (T9) below -->
    <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource RailBgBrush}">
      <DockPanel Margin="24" LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Spacing="16">
          <Image Source="avares://installer/Assets/default-logo.png" Height="48" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding Brand.AppName}" Foreground="{DynamicResource RailTextBrush}" FontSize="22" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Brand.Publisher}" Foreground="{DynamicResource RailMutedBrush}" FontSize="13" />
          <!-- T11 / decision 7: verified-signature-gated trust line. Visible only
               when the manifest declared `sign` AND WinVerifyTrust(self) == valid. -->
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Brand.HasTrustLine}">
            <TextBlock Text="&#x1F512;" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource RailTextBrush}" />
            <TextBlock x:Name="TrustLine" Text="{Binding Brand.TrustLine}" FontSize="12"
                       VerticalAlignment="Center" Foreground="{DynamicResource RailTextBrush}" />
          </StackPanel>
        </StackPanel>

        <!-- Step indicator, generated from the resolved (When-visible) screen set -->
        <ItemsControl DockPanel.Dock="Top" Margin="0,32,0,0" ItemsSource="{Binding RailSteps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RailStep">
              <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5">
                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                        Background="{DynamicResource RailTextBrush}" Opacity="{Binding LabelOpacity}" />
                <TextBlock Text="{Binding Label}" FontSize="13"
                           Foreground="{DynamicResource RailTextBrush}"
                           FontWeight="{Binding LabelWeight}" Opacity="{Binding LabelOpacity}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- Content host -->
    <ContentControl x:Name="ScreenHost" Grid.Row="0" Grid.Column="1" Margin="32"
                    Content="{Binding}"
                    ContentTemplate="{StaticResource ScreenSelector}" />

    <!-- Footer -->
    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource FrameBrush}" BorderThickness="0,1,0,0" Padding="16,8">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Content="Back" IsEnabled="{Binding CanGoBack}" Click="OnBack" />
        <Button Content="Next" IsEnabled="{Binding CanGoNext}" Click="OnNext" Background="{DynamicResource AccentBrush}" Foreground="White" />
        <Button Content="Cancel" Click="OnCancel" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
