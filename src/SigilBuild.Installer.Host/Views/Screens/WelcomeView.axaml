<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SigilBuild.Installer.Host.ViewModels"
             xmlns:loc="clr-namespace:SigilBuild.Wrapper.Core.Localization;assembly=SigilBuild.Wrapper.Core"
             x:DataType="vm:InstallerViewModel"
             x:Class="SigilBuild.Installer.Host.Views.Screens.WelcomeView">
  <StackPanel Spacing="16">
    <TextBlock x:Name="Heading" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
               Text="{Binding Brand.AppName, StringFormat='Welcome to {0} setup'}" />
    <TextBlock TextWrapping="Wrap" Foreground="#4B5563"
               Text="{x:Static loc:S.WelcomeBody}" />
    <!-- P3: upgrade banner ("Upgrading from x.y.z"), shown only during an upgrade. -->
    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
               Foreground="{DynamicResource AccentBrush}"
               IsVisible="{Binding HasUpgradeNotice}"
               Text="{Binding UpgradeNotice}" />
  </StackPanel>
</UserControl>
