<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SigilBuild.Installer.Host.ViewModels"
             x:DataType="vm:InstallerViewModel"
             x:Class="SigilBuild.Installer.Host.Views.Screens.InstallOptionsView">
  <StackPanel Spacing="12">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Install location" />
    <TextBlock Text="Where should the application be installed?" Foreground="#4B5563" />
    <TextBox x:Name="InstallPath" Text="{Binding InstallPath, Mode=TwoWay}" />
  </StackPanel>
</UserControl>
