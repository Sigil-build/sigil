<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <!-- Required for [LibraryImport] source-generated P/Invokes used by
         ExeWrapper/WrapperResourceWriter.cs (BeginUpdateResource etc.). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SigilBuild.Core\SigilBuild.Core.csproj" />
    <ProjectReference Include="..\SigilBuild.Installer.BrandGenerator\SigilBuild.Installer.BrandGenerator.csproj"
                      ReferenceOutputAssembly="true" />
    <!-- The packager builds the SIGIL_BLOB_V1 JSON at pack time via the same
         internal DTOs + source-generated SerializerContext the wrapper runtime
         uses to read it back (single source of truth for the wire schema), and
         calls SigilBuild.Wrapper.Codec.PayloadCodec (ZstdSharp-backed) to build
         the SIGIL_PAYLOAD_V2 container. Those types live in
         SigilBuild.Wrapper.Core after the Task T1 engine split.
         T4 NOTE: this reference must flow its runtime assets — including the
         transitive ZstdSharp.Port assembly — to Packaging consumers (the CLI),
         or `sigil pack` with the exe format throws FileNotFoundException for
         ZstdSharp at PayloadCodec.Encode. A prior PrivateAssets="all" stripped
         exactly that transitive package (while the engine DLL flowed anyway),
         so it is removed. -->
    <ProjectReference Include="..\SigilBuild.Wrapper.Core\SigilBuild.Wrapper.Core.csproj"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test project drives the internal WrapperResourceWriter and the
         WrapperRuntimeLocator directly. -->
    <InternalsVisibleTo Include="SigilBuild.Packaging.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Condition="'$(OS)' == 'Windows_NT'" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Condition="'$(OS)' != 'Windows_NT'" />
  </ItemGroup>
</Project>
