<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SigilBuild.Installer.Host.ViewModels"
             x:DataType="vm:InstallerViewModel"
             x:Class="SigilBuild.Installer.Host.Views.Screens.FinishView">
  <StackPanel Spacing="12" VerticalAlignment="Center">
    <TextBlock FontSize="22" FontWeight="Bold"
               Text="{Binding Brand.AppName, StringFormat='{}{0} is installed'}" />
    <TextBlock Text="You can now launch the application from the Start menu." Foreground="#4B5563" />
    <CheckBox Content="Launch now" IsChecked="{Binding LaunchAfterInstall, Mode=TwoWay}" />
  </StackPanel>
</UserControl>
