{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sigil.build/schemas/v1/sigil-schema.json",
  "title": "Sigil manifest",
  "description": "Sigil v1.0 manifest (sigil.yaml). Single source of truth for pack -> sign -> publish -> update.",
  "type": "object",
  "required": ["spec", "app", "build"],
  "additionalProperties": false,
  "definitions": {
    "Parameters": {
      "type": "object",
      "description": "Install-time / pack-time parameter declarations consumed by the wrapper installer (Sprint 5c).",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["string", "path", "bool", "int", "enum", "secret"]
          },
          "default": {},
          "values": { "type": "array", "items": { "type": "string" } },
          "install_time": { "type": "boolean", "default": false },
          "description": { "type": "string" },
          "pattern": { "type": "string" },
          "min": { "type": "integer" },
          "max": { "type": "integer" },
          "screen": {
            "type": "string",
            "description": "Optional wizard page label. Parameters that share a screen value are grouped onto the same Install Options screen in the wrapper installer. Parameters without a screen value land on a default 'Install Options' page after all named screens."
          },
          "source": {
            "type": "object",
            "description": "Dynamic options source. The wizard fetches `url` at install time, parses JSON, and populates a ComboBox with the items at `items_path` keyed by `value_property` / labelled by `label_property`.",
            "required": ["url", "items_path", "value_property", "label_property"],
            "additionalProperties": false,
            "properties": {
              "url":            { "type": "string" },
              "items_path":     { "type": "string" },
              "value_property": { "type": "string" },
              "label_property": { "type": "string" }
            }
          }
        }
      }
    },
    "InstallStep": {
      "type": "object",
      "description": "A single declarative install step. Per-type parameter shapes are validated by the typed deserializer (Sprint 5c, Task 9), not in JSON Schema.",
      "required": ["id", "type"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "file_copy", "directory_create", "file_delete", "directory_delete",
            "registry_write", "registry_delete_value", "registry_delete_key",
            "shortcut_create", "env_set", "run_program", "service_install"
          ]
        },
        "when": { "type": "string" },
        "on_failure": { "type": "string", "enum": ["rollback", "continue", "fail"] }
      }
    },
    "InstallStepList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "file_copy", "directory_create", "file_delete", "directory_delete",
              "registry_write", "registry_delete_value", "registry_delete_key",
              "shortcut_create", "env_set", "run_program", "service_install"
            ]
          },
          "when": { "type": "string" },
          "on_failure": { "type": "string", "enum": ["rollback", "continue", "fail"] }
        }
      }
    }
  },
  "properties": {
    "spec": {
      "type": "string",
      "description": "Manifest schema version. Pinned to v1.0 for the MVP.",
      "const": "v1.0"
    },
    "app": {
      "type": "object",
      "required": ["id", "name", "version", "publisher"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Reverse-DNS application id, e.g. com.example.MyApp.",
          "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)+$",
          "minLength": 3,
          "maxLength": 255
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "version": {
          "type": "string",
          "description": "Semantic version (Semver 2.0.0).",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
        },
        "publisher": {
          "type": "string",
          "description": "Display name or X.500 distinguished name (CN=...).",
          "minLength": 1
        },
        "description": { "type": "string" },
        "homepage": { "type": "string", "format": "uri" }
      }
    },
    "build": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "description": "Path (relative to manifest) to the directory whose contents will be packaged.",
          "minLength": 1
        },
        "include": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Glob patterns (relative to source) to include. Defaults to ['**/*']."
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Glob patterns (relative to source) to exclude."
        },
        "deterministic": {
          "type": "boolean",
          "default": true,
          "description": "Reproducible build: sort entries, fixed mtimes, no host metadata."
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formats": {
          "type": "array",
          "items": { "enum": ["msix", "zip", "exe"] },
          "minItems": 1,
          "uniqueItems": true,
          "default": ["zip"]
        },
        "architectures": {
          "type": "array",
          "items": { "enum": ["x64", "arm64"] },
          "minItems": 1,
          "uniqueItems": true,
          "default": ["x64"]
        },
        "msix": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "publisher": {
              "type": "string",
              "description": "X.500 distinguished name; must match the signing cert subject."
            },
            "logo": {
              "type": "string",
              "description": "Path to a master logo (PNG, square). Sigil will resize for tiles."
            },
            "capabilities": {
              "type": "array",
              "items": { "type": "string" }
            },
            "runWack": {
              "type": "boolean",
              "default": false,
              "description": "If true, run the Windows App Certification Kit (appcert.exe) against the packed MSIX. Emits SIG0111 (warning) when WACK isn't installed and SIG0112 (error) when WACK reports failures. WBS 2.9."
            }
          }
        }
      }
    },
    "sign": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": ["none", "local", "azure-trusted-signing"],
          "default": "none"
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pfx"],
          "properties": {
            "pfx": { "type": "string", "description": "Path to a .pfx file." },
            "passwordEnv": {
              "type": "string",
              "description": "Name of the environment variable holding the PFX password."
            },
            "timestampUrl": {
              "type": "string",
              "format": "uri",
              "default": "http://timestamp.digicert.com"
            }
          }
        },
        "azureTrustedSigning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint", "accountName", "certificateProfile"],
          "properties": {
            "endpoint": { "type": "string", "format": "uri" },
            "accountName": { "type": "string", "minLength": 1 },
            "certificateProfile": { "type": "string", "minLength": 1 },
            "tenantIdEnv": { "type": "string", "default": "AZURE_TENANT_ID" },
            "clientIdEnv": { "type": "string", "default": "AZURE_CLIENT_ID" },
            "clientSecretEnv": { "type": "string", "default": "AZURE_CLIENT_SECRET" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "provider": { "const": "local" } }, "required": ["provider"] },
          "then": { "required": ["local"] }
        },
        {
          "if": {
            "properties": { "provider": { "const": "azure-trusted-signing" } },
            "required": ["provider"]
          },
          "then": { "required": ["azureTrustedSigning"] }
        }
      ]
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo"],
          "properties": {
            "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
            "tagPrefix": { "type": "string", "default": "v" },
            "draft": { "type": "boolean", "default": false }
          }
        }
      }
    },
    "updates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": { "type": "string", "default": "stable", "minLength": 1 },
        "manifestUrl": { "type": "string", "format": "uri" },
        "deltaTargets": {
          "type": "integer",
          "description": "How many previous versions to generate delta patches against.",
          "minimum": 0,
          "maximum": 20,
          "default": 3
        },
        "signingKey": {
          "type": "string",
          "description": "Path to an Ed25519 private key (PEM) used to sign the update manifest."
        }
      }
    },
    "installer": {
      "type": "object",
      "description": "Branded Windows installer wizard config (Phase 2.5 / D-011). Tokens are emitted at pack time by BrandTokenEmitter; WCAG-AA contrast is enforced against white text.",
      "additionalProperties": false,
      "properties": {
        "icon": {
          "type": "string",
          "description": "Path (relative to the manifest) to a .ico file that becomes the produced setup.exe's Explorer icon. When omitted, the bundled default icon is used."
        },
        "brand": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "logo": { "type": "string" },
            "hero": { "type": "string" },
            "primaryColor": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "accentColor": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "gradientStart": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "First stop of the three-stop sidebar gradient."
            },
            "gradientMid": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Middle stop of the three-stop sidebar gradient."
            },
            "gradientEnd": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Last stop of the three-stop sidebar gradient."
            }
          }
        }
      }
    },
    "parameters": {
      "type": "object",
      "description": "Install-time / pack-time parameter declarations consumed by the wrapper installer (Sprint 5c).",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["string", "path", "bool", "int", "enum", "secret"]
          },
          "default": {},
          "values": { "type": "array", "items": { "type": "string" } },
          "install_time": { "type": "boolean", "default": false },
          "description": { "type": "string" },
          "pattern": { "type": "string" },
          "min": { "type": "integer" },
          "max": { "type": "integer" },
          "screen": {
            "type": "string",
            "description": "Optional wizard page label. Parameters that share a screen value are grouped onto the same Install Options screen in the wrapper installer. Parameters without a screen value land on a default 'Install Options' page after all named screens."
          },
          "source": {
            "type": "object",
            "description": "Dynamic options source. The wizard fetches `url` at install time, parses JSON, and populates a ComboBox with the items at `items_path` keyed by `value_property` / labelled by `label_property`.",
            "required": ["url", "items_path", "value_property", "label_property"],
            "additionalProperties": false,
            "properties": {
              "url":            { "type": "string" },
              "items_path":     { "type": "string" },
              "value_property": { "type": "string" },
              "label_property": { "type": "string" }
            }
          }
        }
      }
    },
    "install_steps": {
      "type": "array",
      "description": "Main install-time step list executed by the wrapper installer (Sprint 5c). Per-step parameter shapes are validated by the typed deserializer.",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "file_copy", "directory_create", "file_delete", "directory_delete",
              "registry_write", "registry_delete_value", "registry_delete_key",
              "shortcut_create", "env_set", "run_program", "service_install"
            ]
          },
          "when": { "type": "string" },
          "on_failure": { "type": "string", "enum": ["rollback", "continue", "fail"] }
        }
      }
    },
    "pre_install": {
      "type": "array",
      "description": "Steps executed before the main install_steps block.",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "file_copy", "directory_create", "file_delete", "directory_delete",
              "registry_write", "registry_delete_value", "registry_delete_key",
              "shortcut_create", "env_set", "run_program", "service_install"
            ]
          },
          "when": { "type": "string" },
          "on_failure": { "type": "string", "enum": ["rollback", "continue", "fail"] }
        }
      }
    },
    "post_install": {
      "type": "array",
      "description": "Steps executed after the main install_steps block.",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "file_copy", "directory_create", "file_delete", "directory_delete",
              "registry_write", "registry_delete_value", "registry_delete_key",
              "shortcut_create", "env_set", "run_program", "service_install"
            ]
          },
          "when": { "type": "string" },
          "on_failure": { "type": "string", "enum": ["rollback", "continue", "fail"] }
        }
      }
    },
    "uninstall": {
      "type": "array",
      "description": "Steps executed at the start of `setup.exe /Uninstall`, BEFORE the rollback journal replays. Lets the manifest tear down services / scheduled tasks / external scripts that the install journal doesn't cover.",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": [
              "file_copy", "directory_create", "file_delete", "directory_delete",
              "registry_write", "registry_delete_value", "registry_delete_key",
              "shortcut_create", "env_set", "run_program", "service_install"
            ]
          },
          "when": { "type": "string" },
          "on_failure": { "type": "string", "enum": ["rollback", "continue", "fail"] }
        }
      }
    }
  }
}
