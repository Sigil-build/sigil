<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SigilBuild.Installer.Host.ViewModels"
             xmlns:loc="clr-namespace:SigilBuild.Wrapper.Core.Localization;assembly=SigilBuild.Wrapper.Core"
             x:DataType="vm:InstallerViewModel"
             x:Class="SigilBuild.Installer.Host.Views.Screens.OptionsView">
  <!-- Built-in configurable Options screen (T8): one checkbox per enabled
       component. `locked` components render disabled (always applied). The
       checked states flow into option.* for the engine's step gating. -->
  <StackPanel Spacing="12">
    <TextBlock FontSize="20" FontWeight="SemiBold"
               Foreground="{DynamicResource TextPriBrush}" Text="{x:Static loc:S.OptionsTitle}" />
    <TextBlock Foreground="{DynamicResource TextMutBrush}" TextWrapping="Wrap"
               Text="{x:Static loc:S.OptionsBody}" />
    <ItemsControl ItemsSource="{Binding OptionItems}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:OptionItemViewModel">
          <!-- P10 (gap G11): built-ins + app-defined custom components share this
               row. A custom component may carry an optional description, shown
               under the checkbox caption when present. -->
          <StackPanel Margin="0,4">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      IsEnabled="{Binding IsEnabled}" />
            <TextBlock Margin="28,0,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutBrush}"
                       IsVisible="{Binding HasDescription}"
                       Text="{Binding Description}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
