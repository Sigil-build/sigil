<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SigilBuild.Installer.Host.ViewModels"
             x:DataType="vm:InstallerViewModel"
             x:Class="SigilBuild.Installer.Host.Views.Screens.CustomView">
  <!-- Declared custom screen (T9): the fields are built in code-behind from the
       current screen's FieldViewModels via the widget factory. -->
  <ScrollViewer>
    <StackPanel Spacing="16">
      <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPriBrush}" />
      <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource TextMutBrush}"
                 TextWrapping="Wrap" IsVisible="False" />
      <StackPanel x:Name="FieldsHost" Spacing="14" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
