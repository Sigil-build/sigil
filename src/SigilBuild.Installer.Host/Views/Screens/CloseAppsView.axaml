<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SigilBuild.Installer.Host.ViewModels"
             x:DataType="vm:InstallerViewModel"
             x:Class="SigilBuild.Installer.Host.Views.Screens.CloseAppsView">
  <StackPanel Spacing="14" VerticalAlignment="Center">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Close these applications to continue" />
    <TextBlock Foreground="#4B5563" TextWrapping="Wrap"
               Text="Setup needs to update files that these applications are using. Close them and choose Retry, or let Setup close them for you." />

    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
            Height="150" Padding="12,8">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Blockers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Foreground="#374151" FontSize="12" Margin="0,3" TextWrapping="NoWrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button Content="Retry" Click="OnRetry" />
      <Button Content="Close for me" Click="OnCloseForMe"
              Background="{DynamicResource AccentBrush}" Foreground="White" />
    </StackPanel>
    <TextBlock Foreground="#6B7280" FontSize="11" TextWrapping="Wrap"
               Text="Close for me asks each application to shut down normally — unsaved work is not discarded. Applications are not restarted afterwards." />
  </StackPanel>
</UserControl>
