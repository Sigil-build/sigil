<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SigilBuild.Cli</RootNamespace>
    <AssemblyName>sigil</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sigil</ToolCommandName>
    <PackageId>SigilBuild</PackageId>
    <!-- R24: Version comes from Directory.Build.props, the single source of
         truth. Do not set it here; see the comment there. -->
    <Description>Sigil — declarative desktop-software distribution CLI.</Description>
    <PackageTags>installer;packaging;codesigning;msix;delta-update</PackageTags>

    <!-- I3/R23a: declare BOTH shipping RIDs so `dotnet restore` walks the
         RID-specific package graph and records `net10.0/win-x64` +
         `net10.0/win-arm64` sections in packages.lock.json. Without them the
         locked restore only covers the RID-less graph and every
         `dotnet publish -r <rid>` re-resolves packages outside the lock.
         RuntimeIdentifiers (plural) informs RESTORE only; it does not pin a
         RuntimeIdentifier, so the default RID-less `dotnet build` is unchanged. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Native AOT -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>full</TrimMode>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!-- Surface AOT compatibility issues at build time, not run time -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SigilBuild.Core\SigilBuild.Core.csproj" />
    <ProjectReference Include="..\SigilBuild.Packaging\SigilBuild.Packaging.csproj" />
    <ProjectReference Include="..\SigilBuild.Signing\SigilBuild.Signing.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Commands\Templates\*.yaml" />
  </ItemGroup>
</Project>
