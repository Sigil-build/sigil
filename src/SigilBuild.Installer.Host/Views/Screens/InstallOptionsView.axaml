<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SigilBuild.Installer.Host.ViewModels"
             x:DataType="vm:InstallerViewModel"
             x:Class="SigilBuild.Installer.Host.Views.Screens.InstallOptionsView">
  <!-- Destination screen (T13): where the app installs. The collected path becomes
       {install_dir}. When scope is `auto` (T12) the user/machine radios show and
       swap the default path between %LocalAppData%\Programs and Program Files. -->
  <StackPanel Spacing="12">
    <TextBlock FontSize="20" FontWeight="SemiBold"
               Foreground="{DynamicResource TextPriBrush}" Text="Choose install location" />
    <TextBlock Foreground="{DynamicResource TextMutBrush}" TextWrapping="Wrap"
               Text="Where should the application be installed?" />

    <Grid ColumnDefinitions="*,Auto">
      <TextBox Grid.Column="0" x:Name="InstallPath"
               Text="{Binding InstallPath, Mode=TwoWay}" />
      <Button Grid.Column="1" x:Name="BrowseButton" Content="Browse…"
              Margin="8,0,0,0" Click="OnBrowse" />
    </Grid>

    <!-- Inline validation error: absolute / non-file / writable-or-elevatable. -->
    <TextBlock Foreground="{DynamicResource DangerTextBrush}" FontSize="12"
               TextWrapping="Wrap"
               IsVisible="{Binding HasInstallPathError}"
               Text="{Binding InstallPathError}" />

    <!-- Scope choice (T12), shown only when the manifest scope is `auto`. -->
    <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding ScopeSelectable}">
      <RadioButton GroupName="scope" IsChecked="{Binding IsUserScope, Mode=TwoWay}">
        <StackPanel>
          <TextBlock Text="Just for me (recommended)" FontWeight="SemiBold" />
          <TextBlock Text="No administrator permission needed"
                     Foreground="{DynamicResource TextMutBrush}" FontSize="12" />
        </StackPanel>
      </RadioButton>
      <RadioButton GroupName="scope" IsChecked="{Binding IsMachineScope, Mode=TwoWay}">
        <StackPanel>
          <TextBlock Text="All users of this computer" FontWeight="SemiBold" />
          <TextBlock Text="Installs to Program Files — Windows will ask for permission"
                     Foreground="{DynamicResource TextMutBrush}" FontSize="12" />
        </StackPanel>
      </RadioButton>
    </StackPanel>
  </StackPanel>
</UserControl>
