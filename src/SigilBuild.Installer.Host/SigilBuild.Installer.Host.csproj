<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SigilBuild.Installer.Host</RootNamespace>
    <AssemblyName>installer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- T3 / ADR-avalonia-aot: BuiltInComInteropSupport is deliberately NOT set.
         It was the sole source of the IL2026 trim warning (the built-in-COM
         *server* activation path, ComActivator.GetClassFactoryForTypeInternal —
         a managed-COM-server export an installer wizard never uses). Avalonia 12's
         Win32 backend uses ComWrappers-based Micro-COM for its clipboard / OLE /
         shell-dialog *client* interop, which needs no built-in COM support, so
         dropping the flag removes the dead server path and makes the Native AOT
         publish warning-clean under TreatWarningsAsErrors — the honest fix per the
         ADR (rd.xml / a root descriptor would only mask the dead path). -->
    <!-- Required for the source-generated [LibraryImport] AttachConsole P/Invoke
         used by the /silent headless path (Program.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- AOT — Avalonia 12 makes this clean -->
    <PublishAot Condition="'$(SigilAotPublish)' == 'true'">true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebuggerSupport>false</DebuggerSupport>

    <!-- Avalonia 12: compiled bindings on by default. Belt-and-suspenders. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableAvaloniaXamlCompilation>true</EnableAvaloniaXamlCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Svg.Skia" />
  </ItemGroup>
  <ItemGroup>
    <!-- T2: the host is the stamped runtime. It drives the real step engine and
         shares one CommandLineParser + InstallSession with the console wrapper. -->
    <ProjectReference Include="..\SigilBuild.Wrapper.Core\SigilBuild.Wrapper.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
