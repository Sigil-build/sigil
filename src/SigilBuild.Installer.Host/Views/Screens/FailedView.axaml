<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SigilBuild.Installer.Host.ViewModels"
             x:DataType="vm:InstallerViewModel"
             x:Class="SigilBuild.Installer.Host.Views.Screens.FailedView">
  <StackPanel Spacing="14" VerticalAlignment="Center">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Installation failed" />
    <TextBlock Text="Setup could not complete. No changes were kept." Foreground="#4B5563" />
    <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" TextWrapping="Wrap" />
    <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8"
            Height="160" Padding="12,8">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding LogLines}">
          <ItemsControl.Styles>
            <Style Selector="TextBlock.err">
              <Setter Property="Foreground" Value="#B42318" />
            </Style>
          </ItemsControl.Styles>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InstallLogLine">
              <TextBlock Classes.err="{Binding IsError}"
                         Text="{Binding Text}"
                         Foreground="#374151"
                         FontFamily="Consolas, 'Cascadia Mono', monospace"
                         FontSize="11"
                         TextWrapping="NoWrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </StackPanel>
</UserControl>
